<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.mmatokovic.fiskalizacija</groupId>
        <artifactId>fiskalizacija-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>fiskalizacija-eracun</artifactId>
    <description>UBL 2.1 eRačun po HR CIUS-u: izrada, validacija i ApplicationResponse</description>

    <dependencies>
        <dependency>
            <groupId>dev.mmatokovic.fiskalizacija</groupId>
            <artifactId>fiskalizacija-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.helger.ubl</groupId>
            <artifactId>ph-ubl21</artifactId>
        </dependency>
        <dependency>
            <groupId>com.helger.phive.rules</groupId>
            <artifactId>phive-rules-eracun</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>../fiskalizacija-core/src/test/resources/primjeri</directory>
                <targetPath>primjeri</targetPath>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <legacyMode>true</legacyMode>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>dev.mmatokovic.fiskalizacija.eracun</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
